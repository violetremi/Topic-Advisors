# 大内密探 - 环境配置文件
# 复制此文件为 .env 并填写真实值

# OpenAI 兼容接口配置
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 数据库（默认 SQLite，可改为 MySQL/PostgreSQL）
# DATABASE_URL=sqlite+aiosqlite:///./intel_agent.db
# DATABASE_URL=mysql+aiomysql://user:pass@localhost/intel_agent
